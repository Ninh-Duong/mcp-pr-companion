{
  "name": "mcp-pr-companion",
  "version": "1.0.0",
  "description": "Local MCP Server for pre-processing Git PR diffs into compact JSON payloads for AI PR description generation",
  "main": "dist/mcp/server.js",
  "bin": {
    "mcp-pr-companion": "bin/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node bin/cli.js server",
    "cmd": "node bin/cli.js cmd",
    "mcp-pr-companion": "node bin/cli.js generate-all",
    "healthcheck": "node bin/cli.js check",
    "prepare-app": "node bin/cli.js prepare",
    "build": "tsc",
    "dev": "tsx --env-file=.env src/mcp/server.ts",
    "test": "node tests/run.mjs"
  },
  "keywords": [
    "mcp",
    "git",
    "pr-description",
    "bitbucket",
    "github",
    "ast"
  ],
  "author": "Ninh Duong",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "cli-progress": "^3.12.0",
    "p-limit": "^7.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

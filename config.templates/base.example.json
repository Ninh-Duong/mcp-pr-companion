{
  "schema_version": 2,
  "provider": "bitbucket-cloud",
  "workspace": "your-company-workspace",
  "output_language": "vi",
  "ticket_prefix": ["WCE-", "PROJ-", "JIRA-"],
  "default_target_branch": "main",
  "default_pr_url": "",
  "sync": {
    "concurrency": 2,
    "request_timeout_ms": 30000,
    "max_retries": 3
  },
  "cache": {
    "memory_entries": 20,
    "ttl_seconds": 300,
    "persist_raw_diff": true,
    "max_revisions_per_pr": 3,
    "retention_days": 30
  },
  "agent_payload": {
    "default_detail": "manifest",
    "max_highlights_per_file": 5,
    "include_generated_files": false
  },
  "ai_context": {
    "root": "ai-context",
    "company": "siliconstack",
    "app": "bitbucket",
    "feature": "list-pr",
    "pr_folder_template": "{repoSlug}_PR-{prId}"
  }
}

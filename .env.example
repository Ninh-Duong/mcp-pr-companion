# mcp-pr-companion configuration.
# Copy to .env (done automatically on first run) and fill in the required values.
# .env is git-ignored: never commit real credentials.

# ---- Required -----------------------------------------------------------------
# Atlassian account email used for the Bitbucket API token.
BITBUCKET_EMAIL=
# Bitbucket API token with READ-ONLY scopes:
#   read:user:bitbucket, read:pullrequest:bitbucket, read:repository:bitbucket
BITBUCKET_API_TOKEN=
# Repository for `cmd` / `generate-all`, format: workspace/repo
# (the MCP server takes the repository from each PR URL instead).
BITBUCKET_REPOSITORY=

# ---- Optional (defaults shown) ------------------------------------------------
# Comma-separated accounts allowed to run the tool. Empty = any account.
ALLOWED_EMAILS=
# Comma-separated ticket prefixes detected in branch names / commits.
TICKET_PREFIXES=WCE-,PROJ-,JIRA-
# Privacy: strict | balanced | debug
PRIVACY_MODE=strict
PRIVACY_REMOVE_AUTHOR=true
# File path mode in output: full | sanitized | basename | opaque
PRIVACY_FILE_PATH_MODE=sanitized
PRIVACY_MAX_COMMIT_SUBJECTS=10
# Output location: <AI_CONTEXT_ROOT>/<AI_CONTEXT_COMPANY>/<workspace>/<repo>/pr_<id>
AI_CONTEXT_ROOT=ai-context
AI_CONTEXT_COMPANY=siliconstack
AI_CONTEXT_APP=bitbucket

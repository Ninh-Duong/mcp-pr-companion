# mcp-pr-companion configuration.
# Copy to .env (done automatically on first run) and fill in the required values.
# .env is git-ignored: never commit real credentials.

# ---- Required -----------------------------------------------------------------
# Atlassian account email used for the Bitbucket API token.
BITBUCKET_EMAIL=
# Bitbucket API token with READ-ONLY scopes:
#   read:user:bitbucket, read:pullrequest:bitbucket, read:repository:bitbucket
BITBUCKET_API_TOKEN=

# ---- Required for cmd / generate-all / sync / check ---------------------------
# Repositories, comma-separated. Each entry is "repo" (uses BITBUCKET_WORKSPACE) or "workspace/repo".
#   BITBUCKET_WORKSPACE=acme
#   BITBUCKET_REPOSITORY=api,web
# generate-all and sync process every repository; cmd lets you pick one.
# Optional for the MCP server (tools take a pr_url / repository argument), but needed for
# list_my_open_prs / list_synced_prs / sync_my_open_prs without a repository argument,
# AUTO_SYNC_ON_START, and the CLI sync command.
# BITBUCKET_WORKSPACE is only needed for entries without a "workspace/" part.
BITBUCKET_WORKSPACE=
BITBUCKET_REPOSITORY=

# ---- Optional (defaults shown) ------------------------------------------------
# Comma-separated accounts allowed to run the tool. Empty = any account.
ALLOWED_EMAILS=
# true = when the MCP server starts, sync every open PR of this account in BITBUCKET_REPOSITORY
# in the background (unchanged PRs cost one request each). mcp-hub starts it once per client session.
AUTO_SYNC_ON_START=false
# Comma-separated ticket prefixes detected in branch names / commits.
TICKET_PREFIXES=WCE-,PROJ-,JIRA-
# Privacy: strict | balanced | debug
PRIVACY_MODE=strict
PRIVACY_REMOVE_AUTHOR=true
# File path mode in output: full | sanitized | basename | opaque
PRIVACY_FILE_PATH_MODE=sanitized
PRIVACY_MAX_COMMIT_SUBJECTS=10
# Output location: <AI_CONTEXT_ROOT>/[<AI_CONTEXT_COMPANY>/]<workspace>/<repo>/<open|draft|merged|declined>/pr_<id>
# AI_CONTEXT_ROOT is relative to the project root (bin/cli.js always runs with cwd = project root).
AI_CONTEXT_ROOT=ai-context
AI_CONTEXT_COMPANY=
# true = also write DEBUG-level log lines to Logs/mcp-server.log.
# DEBUG=true
